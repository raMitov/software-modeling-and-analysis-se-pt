{
  "name": "Netflix Dark",
  "dataColors": ["#E50914", "#B3B3B3", "#831010", "#F5F5F1", "#FF5A63", "#6E6E6E", "#B20710", "#3D3D3D", "#FFA3A8", "#8C8C8C"],
  "background": "#1F1F1F",
  "foreground": "#FFFFFF",
  "tableAccent": "#E50914",
  "good": "#46D369",
  "neutral": "#B3B3B3",
  "bad": "#E50914",
  "maximum": "#E50914",
  "center": "#5A1A1D",
  "minimum": "#1F1F1F",
  "textClasses": {
    "callout": { "fontSize": 26, "fontFace": "Segoe UI Semibold", "color": "#FFFFFF" },
    "title":   { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#FFFFFF" },
    "header":  { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#FFFFFF" },
    "label":   { "fontSize": 10, "fontFace": "Segoe UI", "color": "#B3B3B3" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#1F1F1F" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#2E2E2E" } }, "radius": 14 }],
        "dropShadow": [{ "show": false }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#FFFFFF" } }, "fontSize": 12, "fontFamily": "Segoe UI Semibold" }],
        "subTitle": [{ "fontColor": { "solid": { "color": "#8C8C8C" } }, "fontSize": 9 }],
        "padding": [{ "top": 10, "bottom": 10, "left": 14, "right": 14 }],
        "visualHeader": [{
          "background": { "solid": { "color": "#1F1F1F" } },
          "foreground": { "solid": { "color": "#B3B3B3" } },
          "border": { "solid": { "color": "#1F1F1F" } },
          "transparency": 0
        }],
        "categoryAxis": [{
          "labelColor": { "solid": { "color": "#B3B3B3" } },
          "titleColor": { "solid": { "color": "#8C8C8C" } },
          "gridlineColor": { "solid": { "color": "#2E2E2E" } }
        }],
        "valueAxis": [{
          "labelColor": { "solid": { "color": "#B3B3B3" } },
          "titleColor": { "solid": { "color": "#8C8C8C" } },
          "gridlineColor": { "solid": { "color": "#2E2E2E" } }
        }],
        "legend": [{ "labelColor": { "solid": { "color": "#B3B3B3" } } }],
        "labels": [{ "color": { "solid": { "color": "#F5F5F1" } } }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#0B0B0B" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#000000" } }, "transparency": 0 }]
      }
    },
    "outspacePane": {
      "*": {
        "outspacePane": [{
          "backgroundColor": { "solid": { "color": "#141414" } },
          "foregroundColor": { "solid": { "color": "#FFFFFF" } },
          "transparency": 0
        }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{ "gridHorizontalColor": { "solid": { "color": "#2E2E2E" } }, "rowPadding": 4 }],
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#FFFFFF" } }, "backColor": { "solid": { "color": "#141414" } } }],
        "values": [{
          "fontColorPrimary": { "solid": { "color": "#F5F5F1" } },
          "backColorPrimary": { "solid": { "color": "#1F1F1F" } },
          "fontColorSecondary": { "solid": { "color": "#F5F5F1" } },
          "backColorSecondary": { "solid": { "color": "#242424" } }
        }]
      }
    }
  }
}
