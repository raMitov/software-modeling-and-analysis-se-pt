        <mxCell id="legend" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#999999;fontSize=12;" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#DAE8FC;border:1px solid #6C8EBF;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&amp;nbsp;Geography &amp; currency&lt;br&gt;&lt;span style=&quot;background:#E1D5E7;border:1px solid #9673A6;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&amp;nbsp;Customers&lt;br&gt;&lt;span style=&quot;background:#D5E8D4;border:1px solid #82B366;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&amp;nbsp;Billing&lt;br&gt;&lt;span style=&quot;background:#FFE6CC;border:1px solid #D79B00;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&amp;nbsp;Catalog&lt;br&gt;&lt;span style=&quot;background:#F8CECC;border:1px solid #B85450;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&amp;nbsp;Activity&lt;br&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; primary key &amp;nbsp; &lt;b&gt;FK&lt;/b&gt; foreign key&lt;br&gt;&lt;b&gt;UK&lt;/b&gt; unique (business key) &amp;nbsp; &lt;b&gt;U1&lt;/b&gt; composite unique&lt;br&gt;Notation: Crow's Foot" vertex="1">
          <mxGeometry height="220" width="300" x="1400" y="40" as="geometry" />
        </mxCell>
        <mxCell id="rules" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#999999;fontSize=12;" value="&lt;b&gt;Business rules&lt;/b&gt;&lt;ol style=&quot;margin:4px 0 0 0;padding-left:18px;&quot;&gt;&lt;li&gt;An account has 1–5 profiles; profile names are unique per account.&lt;/li&gt;&lt;li&gt;An account's subscription periods never overlap; at most one is open (EndDate IS NULL).&lt;/li&gt;&lt;li&gt;Viewing happens only while the account has an active subscription.&lt;/li&gt;&lt;li&gt;A profile can only watch titles whose MinAge ≤ its maturity limit.&lt;/li&gt;&lt;li&gt;Movies have RuntimeMinutes and no seasons; series have seasons and episodes.&lt;/li&gt;&lt;li&gt;WatchSession: EpisodeID is required for series and must belong to the title (NULL for movies); the device must belong to the profile's account.&lt;/li&gt;&lt;li&gt;A plan is offered in a country only while a PlanPrice row is valid; price periods for the same plan and country never overlap.&lt;/li&gt;&lt;li&gt;CancellationReason is filled only when EndReason = 'Cancelled'.&lt;/li&gt;&lt;li&gt;Amounts are stored in the price's local currency; USD uses the payment date's ExchangeRate (last known rate on days without one).&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="220" width="940" x="1720" y="40" as="geometry" />
        </mxCell>
        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=top;" value="&lt;b style=&quot;font-size:20px;&quot;&gt;Netflix — Logical data model&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#666;&quot;&gt;Crow's Foot notation · 21 entities&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="600" x="40" y="-50" as="geometry" />
        </mxCell>
